{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IPC Contract: save-and-upload-clip",
  "description": "IPC channel 'save-and-upload-clip' — Electron renderer invokes this on ipcMain to submit a captured violation clip and its metadata for upload.",

  "request": {
    "channel": "save-and-upload-clip",
    "transport": "ipcRenderer.invoke",
    "schema": {
      "type": "object",
      "required": ["blobArrayBuffer", "metadata"],
      "additionalProperties": false,
      "properties": {
        "blobArrayBuffer": {
          "description": "The merged pre+post violation clip as an ArrayBuffer (structured-clone serialisable). Written to a temp .webm file by the main process before forwarding to the Python bridge.",
          "type": "object",
          "comment": "ArrayBuffer type — not expressible in JSON Schema; described here for documentation."
        },
        "metadata": {
          "$ref": "#/definitions/ClipMetadata"
        }
      }
    }
  },

  "response": {
    "description": "Returned by ipcMain.handle after the Python bridge completes or fails the upload.",
    "schema": {
      "oneOf": [
        {
          "title": "Success response",
          "type": "object",
          "required": ["ok", "result"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean", "enum": [true] },
            "result": {
              "type": "object",
              "required": ["uploadStatus", "evidenceUrl"],
              "properties": {
                "uploadStatus": {
                  "type": "string",
                  "enum": ["success", "upload_failed", "clip_unavailable"]
                },
                "evidenceUrl": {
                  "description": "CDN-hosted URL of the uploaded clip. null when uploadStatus != 'success'.",
                  "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
                },
                "reasonCode": {
                  "description": "Machine-readable failure reason. null on success.",
                  "oneOf": [{ "type": "string" }, { "type": "null" }]
                }
              }
            }
          }
        },
        {
          "title": "IPC-level error response",
          "type": "object",
          "required": ["ok", "error"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean", "enum": [false] },
            "error": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "integer" },
                "message": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  },

  "errorEvent": {
    "channel": "clip:upload-error",
    "direction": "main → renderer",
    "transport": "mainWindow.webContents.send",
    "description": "Sent by the main process to the renderer when upload fails after all retries (FR-011). The renderer uses this to display a non-blocking error notification.",
    "schema": {
      "type": "object",
      "required": ["studentId", "examAttemptId", "sessionId", "reasonCode", "timestamp"],
      "properties": {
        "studentId": { "type": "string" },
        "examAttemptId": { "type": "string" },
        "sessionId": { "type": "string" },
        "reasonCode": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },

  "definitions": {
    "ClipMetadata": {
      "type": "object",
      "required": [
        "studentId",
        "examAttemptId",
        "captureWindowStart",
        "captureWindowEnd",
        "primaryViolationType",
        "primaryConfidence",
        "allViolations",
        "description",
        "sessionId"
      ],
      "additionalProperties": false,
      "properties": {
        "studentId": { "type": "string", "minLength": 1 },
        "examAttemptId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "captureWindowStart": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp derived from preViolationChunks[0].timestamp"
        },
        "captureWindowEnd": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp derived from the last postViolationChunks entry's timestamp"
        },
        "primaryViolationType": {
          "type": "string",
          "minLength": 1,
          "description": "Alert code of the violation that triggered the capture (used in the uploaded filename)"
        },
        "primaryConfidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable summary. Single violation: the violation message. Multiple: '{primary} + {N-1} additional violation(s) in clip'."
        },
        "allViolations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ClipViolationEntry" }
        }
      }
    },

    "ClipViolationEntry": {
      "type": "object",
      "required": ["violationType", "confidence", "timestamp", "description"],
      "additionalProperties": false,
      "properties": {
        "violationType": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "timestamp": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
