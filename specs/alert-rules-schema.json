{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestrationConfig",
  "type": "object",
  "properties": {
    "orchestration": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "object",
          "properties": {
            "eye-gaze": {
              "type": "object",
              "properties": {
                "away_threshold_seconds": { "type": "number", "minimum": 0 },
                "weight": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            },
            "face-recognition": {
              "type": "object",
              "properties": {
                "missing_threshold_seconds": { "type": "number", "minimum": 0 },
                "weight": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            },
            "speech-detection": {
              "type": "object",
              "properties": {
                "weight": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            }
          }
        },
        "risk_score_decay": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
